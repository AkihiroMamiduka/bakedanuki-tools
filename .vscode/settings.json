{
    "python.defaultInterpreterPath": "C:/Program Files/Autodesk/Maya2025/bin/mayapy.exe",
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests/unit"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/bakedanuki/bakedanuki-tools/python",
        "${workspaceFolder}/../bakedanuki-util/bakedanuki/bakedanuki-util/python"
    ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "black-formatter.path": [
        "${workspaceFolder}/.venv-format/Scripts/python.exe",
        "-m",
        "black"
    ],
    "black-formatter.args": [
        "--config",
        "${workspaceFolder}/pyproject.toml"
    ],
    "black-formatter.cwd": "${workspaceFolder}"
}
